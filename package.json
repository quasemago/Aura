{
  "name": "aura",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "prebuild": "npm run lint",
    "build": "tsc -p . && tsc-alias -f",
    "postbuild": "cp -R src/locales artifacts/dist/",
    "lint": "eslint . --ext ts",
    "dev": "export NODE_ENV=development && ts-node-dev -r tsconfig-paths/register ./src/index.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quasemago/Aura.git"
  },
  "author": "quasemago <brunoronningfn@gmail.com>",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/quasemago/Aura/issues"
  },
  "homepage": "https://github.com/quasemago/Aura#readme",
  "description": "Project of a chatbot for Discord, built using Nodejs.",
  "dependencies": {
    "axios": "^1.16.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2",
    "i18next": "^26.1.0",
    "inversify": "^8.1.0",
    "ioredis": "^5.10.1",
    "reflect-metadata": "^0.2.2",
    "tsdef": "^0.0.14",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.4.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-sonarjs": "^4.0.3",
    "eslint-plugin-spellcheck": "0.0.20",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "pretty-quick": "^4.2.2",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.7",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.17",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2"
  }
}
